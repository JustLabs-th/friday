# Optional. Every value has the company default; set one only when this app runs somewhere different.
# Copy to .env.local for your own computer. Never commit real secrets.

# The Keycloak realm that signs people in (used for the sign-out link).
#SSO_ISSUER=https://sso.digitalx.srt/auth/realms/srt

# The Keycloak client the sign-in proxy (oauth2-proxy) uses.
#SSO_CLIENT_ID=liam-apps

# The sign-in proxy's address. Empty = "auth." in front of this app's parent domain
# (work-log.apps.digitalx.srt -> http://auth.apps.digitalx.srt).
#AUTH_URL=
